.DS_Store
# Gradle output. Must be "build/" not "/build" — the leading slash anchors to
# the repo root and misses app/build, core/*/build, which is how 1471 generated
# files reached a commit.
build/
**/build/
/captures
.externalNativeBuild
.cxx
local.properties

# Secrets — never commit. See local.properties.template.
google-services.json
**/google-services.json
*.jks
*.keystore
/keystore.properties
.env
.env.*
!.env.template

# Supabase CLI
/supabase/.branches
/supabase/.temp
